{% set star_count = stars %}{% set title = text.titles[stars] %}{% set description = text.messages[stars|string] | random %}{% set tip = text.tip[stars|string] | random %}{% set theme_color = 'theme-red' if stars >= 6 else ('theme-gold' if stars >= 4 else ('theme-gray' if stars <= 1 else 'theme-blue')) %}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=2.0" />
  <title>Schale MomoTalk Recruitment Card</title>

<style>{{ css | safe }}</style>
</head>
<body>

<div class="card-container ba-shittim-card {{ theme_color }}">
  <div class="ba-bg-decor" aria-hidden="true"></div>

  <!-- Giant Authentic S.C.H.A.L.E. Halo Watermark -->
  <svg class="schale-halo-watermark" viewBox="800 80 1400 1500" fill="currentColor" aria-hidden="true">
    <circle cx="1439.58" cy="886.55" r="420.5" fill="none" stroke="currentColor" stroke-width="18"/>
    <circle cx="1438.08" cy="887.05" r="317" fill="none" stroke="currentColor" stroke-width="45"/>
    <path d="M1439.08,252.55c-263.72,0-477.5,43.2-477.5,96.5s213.78,96.5,477.5,96.5s477.5-43.2,477.5-96.5 S1702.8,252.55,1439.08,252.55z M1439.08,430.47c-203.52,0-368.5-36.45-368.5-81.42c0-44.97,164.98-81.42,368.5-81.42 s368.5,36.45,368.5,81.42C1807.58,394.02,1642.6,430.47,1439.08,430.47z"/>
    <path d="M2135.16,877.55l-571.59-0.12v-0.01h-13.71c-40.5,0-102.29-77.99-101.69-142.22h-0.03l0-456.55h-18.99 l-0.1,456.59h-0.01c0.59,63.57-59.93,140.61-100.44,142.18l-585.65,0l-60,9l60,9l584.63,0.12 c40.51,0.29,102.06,78.11,101.46,142.21h0.04v510.6l9.46,55.01l9.46-55.01l0.12-510.6h0.02c-0.6-63.98,60.71-141.6,101.22-142.2 h585.79l60-9L2135.16,877.55z"/>
  </svg>

  <!-- 1. UNIFIED SCHALE HEADER -->
  <header class="ba-header">
    <div class="ba-logo-lockup">
      <img class="ba-logo-img" src="data:image/png;base64," alt="BlueFortune" />
      <div class="ba-tech-indicator" aria-hidden="true">
        <div class="ba-tech-dots">
          <span></span><span></span><span></span>
        </div>
        <div class="ba-tech-slits">
          <span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="ba-tech-barcode">
          <span class="b2"></span><span class="b1"></span><span class="b1"></span><span class="b2"></span>
        </div>
        <div class="ba-tech-line"></div>
      </div>
    </div>

    <div class="sensei-profile-cluster">
      <div class="sensei-meta">
        <div class="sensei-icon-badge" aria-hidden="true">
          <!-- Blue Archive ID Crosshair / Sensei Ring Glyph -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="7.5"></circle>
            <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
            <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
          </svg>
        </div>
        <span class="sensei-name">{{ username | e }}</span>
      </div>
      <div class="sensei-date-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span class="d-val">{{ date_str | e }}</span>
      </div>
    </div>
  </header>

  <!-- 2. HERO ARTWORK STAGE (Uncluttered with Single Bottom-Left Fortune Capsule) -->
  <div class="ba-hero-wrapper">
    {% if image %}
    <img class="ba-art-img" src="{{ image | e }}" alt="Kivotos Student Visual" />
    {% else %}
    <div class="ba-art-placeholder">
      <span>SCHALE // VISUAL ARCHIVE</span>
    </div>
    {% endif %}

    <div class="ba-hero-bottom-overlay">
      <div class="ba-fortune-capsule stars-{{ stars }}">
        <div class="ba-capsule-rank"><span>{{ title | e }}</span></div>
        <div class="ba-capsule-stars">{% for i in range(7) %}<span class="star{{ ' empty' if i >= stars else '' }}">✦</span>{% endfor %}</div>
      </div>
    </div>
  </div>

  <!-- 3. MOMOTALK MESSAGE MODULE -->
  <section class="momotalk-section">
    <div class="momotalk-window">
      <div class="momotalk-header-bar" aria-hidden="true">
        <div class="momo-brand">
          <!-- Authentic Blue Archive MomoTalk Peach Logo -->
          <svg class="momo-peach-icon" viewBox="0 0 512 512">
            <g transform="matrix(1,0,0,1,0,17.05)">
              <path d="M101.8,396.4C48.5,396.4 3.4,450.2 0,475.9C81.4,483.8 196.1,469.1 252.1,410.9C177.4,424.4 116.2,405.7 101.8,396.4ZM281.4,412.5C336.5,485.8 419.1,471 511.9,475.8C515.4,433.7 438.7,394.9 408,393.6C368.1,422.1 284.7,413.1 281.4,412.5Z" fill="#D9F99D"/>
              <path d="M256.4,0C136.8,45 31.5,151.4 31.5,259.4C31.5,344.4 99.9,413.3 226.8,396.7C230.7,396.2 234.4,395.6 238,395C236.9,394.6 235.9,394.1 235.1,393.7C215.7,383.9 181.7,337 196.1,281.1C197.5,340.4 235.8,383.7 253.2,392.1C255.9,393.4 265.1,396.7 278.7,398.8C330.6,406.8 443.6,403.5 466.6,282.1C498.9,111.4 256.4,0 256.4,0Z" fill="#FFFFFF"/>
            </g>
          </svg>
          <span>MomoTalk</span>
        </div>
        <span class="momo-unread-badge">1</span>
      </div>

      <div class="momotalk-chat-body">
        <div class="arona-avatar-box" aria-hidden="true">
          <div class="arona-avatar-img"></div>
          <span class="arona-online-dot"></span>
        </div>

        <div class="chat-content-col">
          <div class="chat-sender-row">
            <span class="sender-name">阿洛娜</span>
          </div>
          <div class="chat-bubble">
            <p class="chat-quote-text">“{{ description | e }}”</p>
            {% if tip %}<p class="chat-extra-note">{{ tip | e }}</p>{% endif %}
          </div>
        </div>
      </div>
    </div>

    <!-- 4. FOOTER (Graphic / Tech Pattern without text clutter) -->
    <footer class="ba-footer" aria-hidden="true">
      <div class="ba-footer-left">
        <div class="ba-slash-bars">
          <span></span><span></span><span></span>
        </div>
        <div class="ba-footer-barcode">
          <span class="w2"></span>
          <span class="w1"></span>
          <span class="w3"></span>
          <span class="sp"></span>
          <span class="w1"></span>
          <span class="w2"></span>
          <span class="w1"></span>
          <span class="w1"></span>
          <span class="sp"></span>
          <span class="w3"></span>
          <span class="w1"></span>
          <span class="w2"></span>
          <span class="w1"></span>
        </div>
        <div class="ba-footer-tech-dots">
          <span class="cross"></span>
          <span class="dot"></span>
          <span class="dot" style="opacity:0.35;"></span>
        </div>
      </div>

      <div class="ba-footer-right">
        <div class="ba-footer-stripes">
          <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="ba-footer-bracket-tag">
          <span>//</span>
          <span>SCHALE</span>
        </div>
      </div>
    </footer>
  </section>
</div>

</body>
</html>

{% set star_count = stars %}{% set title = text.titles[stars] %}{% set description = text.messages[stars|string] | random %}{% set tip = text.tip[stars|string] | random %}{% set theme_color = 'theme-red' if stars >= 6 else ('theme-gold' if stars >= 4 else ('theme-gray' if stars <= 1 else 'theme-blue')) %}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fortune Card</title>

<style>{{ css | safe }}</style>
</head>
<body>
  {% set dimension_class = 'bg-end' if star_count >= 6 else ('bg-overworld' if star_count >= 4 else ('bg-caves' if star_count >= 2 else 'bg-nether')) %}
  <div class="minecraft-fortune-card mc-fortune-card {{ dimension_class }} {{ theme_color }}">
    <!-- Top Bar: Map / Chamber Title & Date -->
    <div class="mc-top-bar">
      <div class="mc-header-label">
        <img class="mc-avatar-icon" src="data:image/png;base64," alt="Diamond">
        <span>{% set max_uname_len = 12 %}{% if username|length > max_uname_len %}{{ username[:max_uname_len] | e }}{% else %}{{ username | e }}{% endif %}</span>
      </div>
      <div class="mc-date-badge">{{ date_str }}</div>
    </div>

    <!-- Main Canvas Viewport: Vertical Item Frame / Painting -->
    <div class="mc-canvas-container">
      <div class="mc-item-frame">
        {% if image %}
          <img class="mc-portrait-img" src="{{ image | e }}" alt="Chamber View">
        {% else %}
          <div class="mc-portrait-fallback">
            <img src="data:image/png;base64," width="40" height="40" alt="Fallback">
            <span>[物品展示框]</span>
          </div>
        {% endif %}
      </div>

      <!-- Minecraft GUI Hotbar Slots for Nether Stars with Beacon Anchor -->
      <div class="mc-hotbar-panel">
        <div class="mc-hotbar-label">
          <img class="mc-emerald-icon" src="data:image/png;base64," alt="Emerald">
          <span class="mc-hotbar-title">幸运等级</span>
        </div>
        <div class="mc-slots-group">
          {% for i in range(7) %}
            <div class="mc-hotbar-slot{% if i < star_count %} slot-active{% endif %}">
              {% if i < star_count %}
                <img class="mc-nether-star" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAjUlEQVQ4y2NgGPQgZcKE/xRp7liy5H9odvZ/sjXfevSIPENABuw8efL/3/8rwDTRBoA0wmw/fe0a2AAQDXMFXoNgGkE2gjQhGwDCIHGc3kH2M0gTDF+6xPD/waNyOJ8oQ2AuANEgzSAappFggML8iRwGyLYSHZgghbBYICsakV1BdmKCGUKWZmRDaJrZAFy16kfYt0HIAAAAAElFTkSuQmCC" alt="Star">
              {% else %}
                <img class="mc-nether-star" src="data:image/png;base64," alt="Unlit Star">
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Lore / Description Panel -->
    <div class="mc-lore-panel">
      <div class="mc-lore-header">
        <div class="mc-lore-title">
          <img class="mc-icon-book" src="data:image/png;base64," alt="Enchanted Book">
          <span>今日箴言</span>
        </div>
        <img class="mc-ender-eye-icon" src="data:image/png;base64," alt="Eye of Ender" title="运势导向">
      </div>
      <div class="mc-lore-body">{{ description | e }}</div>

      {% if tip %}
      <div class="mc-extra-note">
        <strong>⚠ 旁注警示:</strong> {{ tip | e }}
      </div>
      {% endif %}
    </div>


  </div>
</body>
</html>

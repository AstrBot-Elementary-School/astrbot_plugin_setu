{
  "setu_general": {
    "description": "图片获取",
    "type": "object",
    "hint": "",
    "items": {
      "content_mode": {
        "type": "string",
        "description": "图片分级",
        "hint": "sfw：全年龄；r18：R18；mix：混合。",
        "default": "sfw",
        "options": [
          "sfw",
          "r18",
          "mix"
        ]
      },
      "max_count": {
        "type": "int",
        "description": "每次最多图片数",
        "default": 10,
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        }
      },
      "api_type": {
        "type": "string",
        "description": "图片来源",
        "hint": "all：轮流使用内置图片源；custom：使用下方自定义 API。",
        "default": "lolicon",
        "options": [
          "lolicon",
          "sexnyan",
          "custom",
          "all"
        ]
      },
      "show_advanced": {
        "type": "bool",
        "description": "显示更多配置",
        "default": false
      },
      "tag_alias_templates": {
        "type": "template_list",
        "description": "标签别名",
        "hint": "把常用别名转换为图片源使用的标签。",
        "default": [],
        "templates": {
          "alias": {
            "name": "标签别名",
            "hint": "把多个别名映射到一个标准标签。",
            "items": {
              "canonical": {
                "type": "string",
                "description": "标准标签",
                "default": "少女"
              },
              "aliases": {
                "type": "list",
                "description": "别名列表",
                "hint": "每行一个别名。",
                "default": [
                  "girl",
                  "girls"
                ]
              }
            }
          }
        },
        "condition": {
          "show_advanced": true
        }
      },
      "llm_tools_enabled": {
        "type": "bool",
        "description": "允许 LLM 调用工具",
        "default": true,
        "condition": {
          "show_advanced": true
        }
      },
      "natural_language_enabled": {
        "type": "bool",
        "description": "启用短语触发",
        "default": true,
        "condition": {
          "show_advanced": true
        }
      },
      "trigger_templates": {
        "type": "template_list",
        "description": "触发短语",
        "hint": "按顺序匹配一次。留空沿用原语法，删除全部条目则不触发。",
        "default": [
          {
            "__template_key": "setu",
            "phrase": ""
          },
          {
            "__template_key": "doujinshi",
            "phrase": ""
          },
          {
            "__template_key": "fortune",
            "phrase": ""
          }
        ],
        "condition": {
          "show_advanced": true,
          "natural_language_enabled": true
        },
        "templates": {
          "setu": {
            "name": "图片",
            "items": {
              "phrase": {
                "type": "string",
                "description": "短语",
                "hint": "整句匹配，可用 {数量} 和 {标签}，如：给我{数量}张{标签}图片。",
                "default": ""
              }
            }
          },
          "doujinshi": {
            "name": "随机本子",
            "items": {
              "phrase": {
                "type": "string",
                "description": "短语",
                "hint": "整句匹配，可用 {标签}，如：找本{标签}本子。",
                "default": ""
              }
            }
          },
          "fortune": {
            "name": "今日运势",
            "items": {
              "phrase": {
                "type": "string",
                "description": "短语",
                "hint": "填写完整触发语句，如：看看今天运气。",
                "default": ""
              }
            }
          }
        }
      }
    }
  },
  "delivery": {
    "description": "发送与撤回",
    "type": "object",
    "hint": "",
    "items": {
      "send_mode": {
        "type": "string",
        "description": "图片发送方式",
        "hint": "auto：多图时按平台能力合并转发；image：逐张发送；forward：尝试合并转发。",
        "default": "auto",
        "options": [
          "image",
          "forward",
          "auto"
        ]
      },
      "doujinshi_send_mode": {
        "type": "string",
        "description": "本子文件格式",
        "hint": "pdf：生成 PDF；archive：将原图打包为 ZIP。",
        "default": "pdf",
        "options": [
          "pdf",
          "archive"
        ]
      },
      "r18_docx_mode": {
        "type": "bool",
        "description": "R18 图片转 Word 文件",
        "hint": "开启后将R18 图片放入 .docx 文件发送。",
        "default": true
      },
      "auto_revoke_targets": {
        "type": "list",
        "description": "需要撤回的内容",
        "hint": "setu：图片；fortune：今日运势；doujinshi：随机本子。需要平台支持撤回。",
        "default": [
          "doujinshi"
        ],
        "options": [
          "setu",
          "fortune",
          "doujinshi"
        ]
      },
      "auto_revoke_delay": {
        "type": "int",
        "description": "发送后多久撤回（秒）",
        "hint": "0：不撤回。",
        "default": 30
      },
      "auto_revoke_scope": {
        "type": "string",
        "description": "图片撤回范围",
        "hint": "仅在撤回内容包含 setu 时生效。none：不撤回；sfw：全年龄；r18：R18；all：全部。",
        "default": "none",
        "options": [
          "none",
          "sfw",
          "r18",
          "all"
        ]
      },
      "show_advanced": {
        "type": "bool",
        "description": "显示更多配置",
        "default": false
      },
      "doujinshi_max_page": {
        "type": "int",
        "description": "本子最多页数",
        "hint": "0：不限页数。",
        "default": 0,
        "condition": {
          "show_advanced": true
        }
      },
      "compress_enabled": {
        "type": "bool",
        "description": "压缩大图",
        "hint": "发送前压缩超过目标大小的图片。",
        "default": false,
        "condition": {
          "show_advanced": true
        }
      },
      "compress_max_mb": {
        "type": "int",
        "description": "压缩目标大小（MB）",
        "default": 4,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        },
        "condition": {
          "compress_enabled": true,
          "show_advanced": true
        }
      },
      "html_card_strategy": {
        "type": "string",
        "description": "图片卡片发送",
        "hint": "fallback：普通发送失败后尝试卡片；never：不用卡片；always：始终用卡片。卡片渲染会将完整图片上传到 AstrBot 配置的 t2i 服务；使用远程服务时，图片将传至该服务。若不希望上传，请选 never。",
        "default": null,
        "options": [
          "never",
          "fallback",
          "always"
        ],
        "condition": {
          "show_advanced": true
        }
      },
      "platform_transports": {
        "type": "template_list",
        "description": "平台传输设置",
        "hint": "使用 NapCat 流式上传或共享目录发送时设置。",
        "default": [],
        "templates": {
          "napcat": {
            "name": "NapCat / OneBot 配置",
            "hint": "用于 NapCat 类 OneBot 平台的 stream 上传和本地 file:// 直通。",
            "items": {
              "stream_mode": {
                "type": "string",
                "description": "流式上传",
                "hint": "disabled：关闭；fallback：普通发送失败后使用；always：优先使用。",
                "default": "fallback",
                "options": [
                  "disabled",
                  "fallback",
                  "always"
                ]
              },
              "local_file_mode": {
                "type": "string",
                "description": "通过共享目录发送",
                "hint": "NapCat 必须能读取图片路径。disabled：关闭；fallback：普通发送失败后使用；always：优先使用。",
                "default": "disabled",
                "options": [
                  "disabled",
                  "fallback",
                  "always"
                ]
              },
              "local_file_allowed_roots": {
                "type": "list",
                "description": "允许读取的共享目录",
                "hint": "每行一个 NapCat 可读取的绝对目录。插件发送缓存目录已允许。",
                "default": []
              }
            }
          }
        },
        "condition": {
          "show_advanced": true
        }
      },
      "doujinshi_enabled": {
        "type": "bool",
        "description": "启用随机本子",
        "hint": "关闭后不再下载本子；已有文件和撤回任务保留。",
        "default": true,
        "condition": {
          "show_advanced": true
        }
      }
    }
  },
  "fortune": {
    "description": "今日运势",
    "type": "object",
    "hint": "",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用今日运势",
        "default": true
      },
      "card_theme": {
        "type": "string",
        "description": "卡片视觉风格",
        "hint": "endfield：明日方舟：终末地；blue_archive：碧蓝档案；persona_5：女神异闻录5；random：新风格随机切换；default：经典赛博卡片。",
        "default": "endfield",
        "options": [
          "endfield",
          "blue_archive",
          "persona_5",
          "random",
          "default"
        ],
        "condition": {
          "enabled": true
        }
      },
      "content_mode": {
        "type": "string",
        "description": "背景图片分级",
        "hint": "sfw：全年龄；r18：R18；mix：混合。",
        "default": "sfw",
        "options": [
          "sfw",
          "r18",
          "mix"
        ],
        "condition": {
          "enabled": true
        }
      },
      "tags": {
        "type": "string",
        "description": "背景图片标签",
        "hint": "多个标签用逗号分隔，留空不限标签。",
        "default": "",
        "condition": {
          "enabled": true
        }
      },
      "show_advanced": {
        "type": "bool",
        "description": "显示更多配置",
        "default": false,
        "condition": {
          "enabled": true
        }
      },
      "allow_user_refresh": {
        "type": "bool",
        "description": "允许普通用户刷新",
        "hint": "关闭后，仅管理员可以刷新自己的运势。",
        "default": false,
        "condition": {
          "enabled": true,
          "show_advanced": true
        }
      },
      "auto_refresh": {
        "type": "bool",
        "description": "后台预生成运势",
        "hint": "启动后及每天零点，为近期活跃用户提前生成运势和图片缓存。",
        "default": true,
        "condition": {
          "enabled": true,
          "show_advanced": true
        }
      }
    }
  },
  "session_configs": {
    "type": "template_list",
    "description": "会话设置",
    "hint": "只设置与全局不同的选项。每个 SID 可各添加一条图片和运势规则。",
    "default": [],
    "templates": {
      "setu": {
        "name": "图片与发送",
        "items": {
          "session_id": {
            "type": "string",
            "description": "会话 SID",
            "default": "",
            "hint": "完整格式：平台:消息类型:会话ID，不能只填群号。"
          },
          "content_mode": {
            "type": "string",
            "description": "图片分级",
            "default": "inherit",
            "options": [
              "inherit",
              "sfw",
              "r18",
              "mix"
            ],
            "hint": "inherit：跟随全局；sfw：全年龄；r18：R18；mix：混合。"
          },
          "send_mode": {
            "type": "string",
            "description": "图片发送方式",
            "default": "inherit",
            "options": [
              "inherit",
              "image",
              "forward",
              "auto"
            ],
            "hint": "inherit：跟随全局；auto：自动；image：逐张发送；forward：合并转发。"
          },
          "r18_docx_mode": {
            "type": "string",
            "description": "R18 图片转 Word 文件",
            "default": "inherit",
            "options": [
              "inherit",
              "true",
              "false"
            ],
            "hint": "inherit：跟随全局；true：开启；false：关闭。"
          },
          "auto_revoke_scope": {
            "type": "string",
            "description": "图片撤回范围",
            "default": "inherit",
            "options": [
              "inherit",
              "none",
              "sfw",
              "r18",
              "all"
            ],
            "hint": "inherit：跟随全局；none：不撤回；sfw：全年龄；r18：R18；all：全部。"
          }
        }
      },
      "fortune": {
        "name": "运势背景",
        "items": {
          "session_id": {
            "type": "string",
            "description": "会话 SID",
            "default": "",
            "hint": "完整格式：平台:消息类型:会话ID，不能只填群号。"
          },
          "content_mode": {
            "type": "string",
            "description": "背景图片分级",
            "default": "inherit",
            "options": [
              "inherit",
              "sfw",
              "r18",
              "mix"
            ],
            "hint": "inherit：跟随全局；sfw：全年龄；r18：R18；mix：混合。"
          },
          "override_tags": {
            "type": "bool",
            "description": "单独设置背景标签",
            "default": false,
            "hint": "关闭时跟随全局；开启后留空标签表示不限标签。"
          },
          "tags": {
            "type": "string",
            "description": "背景图片标签",
            "default": "",
            "condition": {
              "override_tags": true
            },
            "hint": "多个标签用逗号分隔，留空不限标签。"
          }
        }
      }
    }
  },
  "safety": {
    "type": "template_list",
    "description": "访问控制",
    "hint": "按完整 SID 控制整个会话；未添加规则时不限制。",
    "default": [],
    "templates": {
      "setu": {
        "name": "色图与随机本子",
        "items": {
          "mode": {
            "type": "string",
            "description": "访问模式",
            "default": "none",
            "options": [
              "none",
              "blacklist",
              "whitelist"
            ],
            "hint": "none：不限；blacklist：拒绝名单内会话；whitelist：只允许名单内会话。"
          },
          "blocked_sids": {
            "type": "list",
            "description": "黑名单 SID",
            "default": [],
            "hint": "每行一个完整 SID：平台:消息类型:会话ID。群聊规则对整个群生效。",
            "condition": {
              "mode": "blacklist"
            }
          },
          "whitelist_sids": {
            "type": "list",
            "description": "白名单 SID",
            "default": [],
            "hint": "每行一个完整 SID：平台:消息类型:会话ID。群聊规则对整个群生效。",
            "condition": {
              "mode": "whitelist"
            }
          }
        }
      },
      "fortune": {
        "name": "今日运势",
        "items": {
          "mode": {
            "type": "string",
            "description": "访问模式",
            "default": "none",
            "options": [
              "none",
              "blacklist",
              "whitelist"
            ],
            "hint": "none：不限；blacklist：拒绝名单内会话；whitelist：只允许名单内会话。"
          },
          "blocked_sids": {
            "type": "list",
            "description": "黑名单 SID",
            "default": [],
            "hint": "每行一个完整 SID：平台:消息类型:会话ID。群聊规则对整个群生效。",
            "condition": {
              "mode": "blacklist"
            }
          },
          "whitelist_sids": {
            "type": "list",
            "description": "白名单 SID",
            "default": [],
            "hint": "每行一个完整 SID：平台:消息类型:会话ID。群聊规则对整个群生效。",
            "condition": {
              "mode": "whitelist"
            }
          }
        }
      }
    }
  },
  "api": {
    "description": "图片来源高级设置",
    "type": "object",
    "hint": "需要更换图片尺寸、代理或接入自定义 API 时再设置。",
    "items": {
      "provider_overrides": {
        "type": "template_list",
        "description": "内置图片源参数",
        "hint": "只添加需要调整的图片源；未添加时使用默认参数。",
        "default": [],
        "templates": {
          "lolicon": {
            "name": "Lolicon",
            "hint": "Lolicon 提供者的专属配置。",
            "items": {
              "image_size": {
                "type": "string",
                "description": "图片尺寸",
                "default": "regular",
                "options": [
                  "original",
                  "regular",
                  "small",
                  "thumb",
                  "mini"
                ],
                "hint": "original：原图；regular：常规；small：小图。"
              },
              "proxy": {
                "type": "string",
                "description": "图片代理地址",
                "default": "",
                "hint": "不需要代理时留空。"
              },
              "aspect_ratio": {
                "type": "string",
                "description": "图片宽高比",
                "default": "",
                "options": [
                  "",
                  "horizontal",
                  "vertical",
                  "square"
                ],
                "hint": "留空不限制。"
              },
              "uid": {
                "type": "list",
                "description": "作者 ID",
                "hint": "每行一个作者 ID。",
                "default": []
              },
              "keyword": {
                "type": "string",
                "description": "搜索关键词",
                "default": "",
                "hint": "留空不限制。"
              },
              "exclude_ai": {
                "type": "bool",
                "description": "排除 AI 生成作品",
                "default": true
              }
            }
          },
          "sexnyan": {
            "name": "SexNyan",
            "hint": "SexNyan V2 支持 author_uuid、keyword、tag；不支持图片尺寸和宽高比过滤。",
            "items": {
              "proxy": {
                "type": "string",
                "description": "图片代理地址",
                "default": "",
                "hint": "不需要代理时留空。"
              },
              "uid": {
                "type": "list",
                "description": "作者 ID",
                "hint": "每行一个作者 ID。",
                "default": []
              },
              "keyword": {
                "type": "string",
                "description": "搜索关键词",
                "default": "",
                "hint": "留空不限制。"
              }
            }
          }
        }
      },
      "custom_api_configs": {
        "type": "template_list",
        "description": "自定义图片 API",
        "hint": "图片来源选 custom 时使用。",
        "default": [],
        "templates": {
          "api_template": {
            "name": "自定义 API",
            "hint": "一个自定义 API 配置。",
            "items": {
              "name": {
                "type": "string",
                "description": "名称",
                "default": "My custom API"
              },
              "url": {
                "type": "string",
                "description": "API 地址",
                "hint": "支持 {num}、{r18}、{tags} 占位符。",
                "default": "https://api.example.com/images?num={num}&tag={tags}"
              },
              "method": {
                "type": "string",
                "description": "HTTP 方法",
                "default": "GET",
                "options": [
                  "GET",
                  "POST"
                ]
              },
              "timeout": {
                "type": "int",
                "description": "超时秒数",
                "default": 30
              },
              "parser_type": {
                "type": "string",
                "description": "响应解析方式",
                "hint": "auto：自动识别；json：按下方路径提取图片地址。",
                "default": "auto",
                "options": [
                  "auto",
                  "json"
                ]
              },
              "json_path": {
                "type": "string",
                "description": "JSON 路径",
                "hint": "当 parser_type=json 时使用。示例：$.data[*].url",
                "default": "",
                "condition": {
                  "parser_type": "json"
                }
              }
            }
          }
        }
      }
    }
  },
  "html_card": {
    "type": "string",
    "description": "旧卡片配置（升级迁移用）",
    "default": null,
    "invisible": true
  }
}
